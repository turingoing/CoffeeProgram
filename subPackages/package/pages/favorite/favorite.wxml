<view class="page">
  <view class="hero-card">
    <view class="hero-main">
      <text class="hero-title">我的收藏</text>
      <text class="hero-desc">收藏的饮品会展示在这里，方便你快速找到喜欢的口味。</text>
    </view>
    <view wx:if="{{!loading && list.length}}" class="hero-count">
      <text class="hero-count-num">{{list.length}}</text>
      <text class="hero-count-unit">款</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">加载中...</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="state-card">
    <text class="state-title">收藏加载失败</text>
    <text class="state-desc">请稍后重新进入页面查看</text>
  </view>

  <view wx:elif="{{list.length === 0}}" class="state-card">
    <text class="state-title">暂无收藏商品</text>
    <text class="state-desc">先去点单页收藏几款喜欢的饮品吧</text>
  </view>

  <view wx:else class="goods-list">
    <view wx:for="{{list}}" wx:key="id" class="goods-card">
      <image class="goods-image" src="{{item.goodsImage}}" mode="aspectFit"></image>

      <view class="goods-info">
        <text class="goods-name">{{item.goodsName}}</text>

        <view wx:if="{{item.specTags.length}}" class="spec-list">
          <text
            wx:for="{{item.specTags}}"
            wx:for-item="spec"
            wx:key="*this"
            class="spec-tag"
          >
            {{spec}}
          </text>
        </view>

        <view class="goods-footer">
          <view class="price-wrap">
            <text class="price-symbol">¥</text>
            <text class="goods-price">{{item.price}}</text>
          </view>
          <view
            class="cancel-btn {{cancelingId === item.id ? 'cancel-btn-loading' : ''}}"
            catchtap="cancelFavorite"
            data-index="{{index}}"
          >
            <text>{{cancelingId === item.id ? '处理中' : '取消收藏'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
